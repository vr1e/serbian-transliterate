{
	"name": "serbian-transliterate",
	"version": "0.1.0",
	"description": "A simple and robust utility for transliterating Serbian text between Cyrillic and Latin (Gaj's Latinica) alphabets.",
	"keywords": [
		"serbian",
		"transliterate",
		"transliteration",
		"cyrillic",
		"latin",
		"serbia",
		"srbija",
		"ćirilica",
		"latinica",
		"gaj",
		"preslovo"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest",
		"build": "rm -rf dist && tsc",
		"format": "prettier --write \"**/*.{ts,md}\"",
		"prepublishOnly": "npm test -- --run && npm run build",
		"bench": "vitest bench --run --reporter=verbose",
		"size": "npm run build && size-limit"
	},
	"author": "vr1e",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vr1e/serbian-transliterate.git"
	},
	"homepage": "https://github.com/vr1e/serbian-transliterate#readme",
	"bugs": {
		"url": "https://github.com/vr1e/serbian-transliterate/issues"
	},
	"devDependencies": {
		"@size-limit/preset-small-lib": "^14.1.0",
		"prettier": "^3.9.9",
		"serbian-transliteration": "^1.0.0",
		"size-limit": "^14.1.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"gzip": true,
			"limit": "650 B"
		}
	]
}
